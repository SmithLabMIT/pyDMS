}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Alpha]num", " ", "=", " ", 
   FractionBox[
    RowBox[{
     RowBox[{"c1", "/", "f1"}], "+", 
     RowBox[{"c2", "/", "f2"}]}], 
    RowBox[{"c3", "/", "f3"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d\[Alpha]numdc1", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{"\[Alpha]num", ",", "c1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d\[Alpha]numdc2", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{"\[Alpha]num", ",", "c2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d\[Alpha]numdc3", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{"\[Alpha]num", ",", "c3"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]\[Alpha]", "[", 
   RowBox[{
   "f1_", ",", "f2_", ",", "f3_", ",", "c1_", ",", "c2_", ",", "c3_", ",", 
    "\[Sigma]c1_", ",", "\[Sigma]c2_", ",", "\[Sigma]c3_"}], "]"}], "=", 
  RowBox[{"Sqrt", "[", 
   RowBox[{
    RowBox[{
     SuperscriptBox["d\[Alpha]numdc1", "2"], " ", 
     SuperscriptBox["\[Sigma]c1", "2"]}], "+", 
    RowBox[{
     SuperscriptBox["d\[Alpha]numdc2", "2"], " ", 
     SuperscriptBox["\[Sigma]c2", "2"]}], "+", 
    RowBox[{
     SuperscriptBox["d\[Alpha]numdc3", "2"], " ", 
     SuperscriptBox["\[Sigma]c3", "2"]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.9482970144306717`*^9, 3.9482970720751495`*^9}, {
  3.948297420696785*^9, 3.9482974992379246`*^9}},
 CellLabel->"In[89]:=",ExpressionUUID->"73c172ae-1207-8c47-9a26-185ba8c5a90e"],

Cell[BoxData[
 SqrtBox[
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["f3", "2"], " ", 
     SuperscriptBox["\[Sigma]c1", "2"]}], 
    RowBox[{
     SuperscriptBox["c3", "2"], " ", 
     SuperscriptBox["f1", "2"]}]], "+", 
   FractionBox[
    RowBox[{
     SuperscriptBox["f3", "2"], " ", 
     SuperscriptBox["\[Sigma]c2", "2"]}], 
    RowBox[{
     SuperscriptBox["c3", "2"], " ", 
     SuperscriptBox["f2", "2"]}]], "+", 
   FractionBox[
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        FractionBox["c1", "f1"], "+", 
        FractionBox["c2", "f2"]}], ")"}], "2"], " ", 
     SuperscriptBox["f3", "2"], " ", 
     SuperscriptBox["\[Sigma]c3", "2"]}], 
    SuperscriptBox["c3", "4"]]}]]], "Output",
 CellChangeTimes->{{3.9482974456106205`*^9, 3.9482974996039295`*^9}},
 CellLabel->"Out[93]=",ExpressionUUID->"9857bc01-d7e8-4944-9dc8-1905fdc6470f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Alpha]denom", " ", "=", " ", 
   FractionBox[
    RowBox[{"c1", "/", "f1"}], 
    RowBox[{
     RowBox[{"c2", "/", "f2"}], "+", 
     RowBox[{"c3", "/", "f3"}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d\[Alpha]denomdc1", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{"\[Alpha]denom", ",", "c1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d\[Alpha]denomdc2", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{"\[Alpha]denom", ",", "c2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d\[Alpha]denomdc3", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{"\[Alpha]denom", ",", "c3"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]\[Alpha]", "[", 
   RowBox[{
   "f1_", ",", "f2_", ",", "f3_", ",", "c1_", ",", "c2_", ",", "c3_", ",", 
    "\[Sigma]c1_", ",", "\[Sigma]c2_", ",", "\[Sigma]c3_"}], "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox["d\[Alpha]denomdc1", "2"], " ", 
      SuperscriptBox["\[Sigma]c1", "2"]}], "+", 
     RowBox[{
      SuperscriptBox["d\[Alpha]denomdc2", "2"], " ", 
      SuperscriptBox["\[Sigma]c2", "2"]}], "+", 
     RowBox[{
      SuperscriptBox["d\[Alpha]denomdc3", "2"], " ", 
      SuperscriptBox["\[Sigma]c3", "2"]}]}], "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.948297531859789*^9, 3.948297587992649*^9}, {
  3.9482976740710487`*^9, 
  3.9482976979463367`*^9}},ExpressionUUID->"f8bf1c14-bf1b-4749-b010-\
41f3a7585b34"],

Cell[BoxData[
 SqrtBox[
  FractionBox[
   RowBox[{
    SuperscriptBox["f3", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["c3", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["f2", "2"], " ", 
          SuperscriptBox["\[Sigma]c1", "2"]}], "+", 
         RowBox[{
          SuperscriptBox["f1", "2"], " ", 
          SuperscriptBox["\[Sigma]c2", "2"]}]}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"c2", " ", "f1"}], "+", 
          RowBox[{"c1", " ", "f2"}]}], ")"}], "2"], " ", 
       SuperscriptBox["\[Sigma]c3", "2"]}]}], ")"}]}], 
   RowBox[{
    SuperscriptBox["c3", "4"], " ", 
    SuperscriptBox["f1", "2"], " ", 
    SuperscriptBox["f2", "2"]}]]]], "Output",
 CellChangeTimes->{{3.9482975708531284`*^9, 3.948297589076086*^9}, 
   3.948297678804409*^9},
 CellLabel->
  "Out[108]=",ExpressionUUID->"85189ef3-c70d-9c4e-a199-2f1ae83679a8"]
}, Open  ]],

Cell[TextData[{
 "Another way of calculating selectivity is based upon the DMS parameters \
themselves:\n",
 Cell[BoxData[{
  RowBox[{"c", "=", 
   RowBox[{
    RowBox[{"kd", " ", "f"}], "+", 
    FractionBox[
     RowBox[{"ch", " ", "b", " ", "f"}], 
     RowBox[{"1", "+", 
      RowBox[{"b", " ", "f"}]}]]}]}], "\[IndentingNewLine]", 
  RowBox[{
   FractionBox["c", "f"], "=", 
   RowBox[{"kd", "+", 
    FractionBox[
     RowBox[{"ch", " ", "b"}], 
     RowBox[{"1", "+", 
      RowBox[{"b", " ", "f"}]}]]}]}], "\[IndentingNewLine]", 
  RowBox[{"\[Alpha]", " ", "=", " ", 
   FractionBox[
    RowBox[{"kd1", "+", 
     FractionBox[
      RowBox[{"ch1", " ", "b1"}], 
      RowBox[{"1", "+", 
       RowBox[{"b1", " ", "f1"}]}]]}], 
    RowBox[{"kd2", "+", 
     FractionBox[
      RowBox[{"ch2", " ", "b2"}], 
      RowBox[{"1", "+", "b2f2"}]]}]]}]}], "Input",
  CellChangeTimes->{{3.9475288694766045`*^9, 3.94752893842622*^9}, {
   3.947529077671402*^9, 3.947529193504593*^9}, {3.947529229084631*^9, 
   3.947529230644953*^9}, {3.947529345935524*^9, 3.9475294144960365`*^9}, {
   3.947529568017948*^9, 3.94752957093277*^9}, {3.947954164847883*^9, 
   3.9479543534698734`*^9}, {3.9479547310882854`*^9, 
   3.9479547312956886`*^9}, {3.9479548841420345`*^9, 3.947954891130596*^9}},
  ExpressionUUID->"587b6e6f-11e0-234d-87de-b0bc66a5b168"],
 "\nThis method can circumvent having to calculate the concentration first, \
however, is more challenging when considering mixed gases as \[Alpha] is \
modified, e.g. ",
 Cell[BoxData[
  RowBox[{"\[Alpha]", " ", "=", " ", 
   FractionBox[
    RowBox[{"kd1", "+", 
