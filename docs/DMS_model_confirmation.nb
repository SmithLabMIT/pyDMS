Cell[CellGroupData[{

Cell["Selectivity via Concentration vs Pressure Data", "Subsection",
 CellChangeTimes->{{3.9481893785249367`*^9, 
  3.948189394709692*^9}},ExpressionUUID->"661f3559-5725-994e-ac07-\
97667979d2c5"],

Cell["\<\
The classic way of calculating selectivity is based upon the ratio of the \
solubility coefficients at some defined pressure p. This method works well if \
this data is known from an experiment or from a adsorption plot\
\>", "Text",
 CellChangeTimes->{{3.9481894012668934`*^9, 3.9481895000558853`*^9}, {
  3.94818954064937*^9, 
  3.9481895417773247`*^9}},ExpressionUUID->"94865aab-b93b-9843-806b-\
cc789de09d1f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Alpha]", " ", "=", " ", 
   FractionBox[
    RowBox[{"c1", "/", "f1"}], 
    RowBox[{"c2", "/", "f2"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Alpha]calc", "[", 
    RowBox[{"f1_", ",", "f2_", ",", "c1_", ",", "c2_"}], "]"}], " ", "=", " ", 
   FractionBox[
    RowBox[{"c1", "/", "f1"}], 
    RowBox[{"c2", "/", "f2"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d\[Alpha]dc1", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{"\[Alpha]", ",", "c1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d\[Alpha]dc2", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{"\[Alpha]", ",", "c2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]\[Alpha]", "[", 
   RowBox[{
   "f1_", ",", "f2_", ",", "c1_", ",", "c2_", ",", "\[Sigma]c1_", ",", 
    "\[Sigma]c2_"}], "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox["d\[Alpha]dc1", "2"], " ", 
      SuperscriptBox["\[Sigma]c1", "2"]}], "+", 
     RowBox[{
      SuperscriptBox["d\[Alpha]dc2", "2"], " ", 
      SuperscriptBox["\[Sigma]c2", "2"]}]}], "]"}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9481893242492733`*^9, 3.9481893368838654`*^9}, {
   3.9481895979609776`*^9, 3.948189600023031*^9}, {3.948189668474331*^9, 
   3.9481896714948807`*^9}, {3.9481899517455177`*^9, 3.948190142596733*^9}, {
   3.948191188884165*^9, 3.9481911895903625`*^9}, {3.9481912824964275`*^9, 
   3.9481912914263535`*^9}, {3.9481913286044807`*^9, 3.948191365202633*^9}, 
   3.948297450932724*^9},
 CellLabel->"In[57]:=",ExpressionUUID->"ab226aae-60c4-2c4e-b6f6-ac41891c8620"],

Cell[BoxData[
 SqrtBox[
  FractionBox[
   RowBox[{
    SuperscriptBox["f2", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["c2", "2"], " ", 
       SuperscriptBox["\[Sigma]c1", "2"]}], "+", 
      RowBox[{
       SuperscriptBox["c1", "2"], " ", 
       SuperscriptBox["\[Sigma]c2", "2"]}]}], ")"}]}], 
   RowBox[{
    SuperscriptBox["c2", "4"], " ", 
    SuperscriptBox["f1", "2"]}]]]], "Output",
 CellChangeTimes->{3.9482974513281975`*^9},
 CellLabel->"Out[61]=",ExpressionUUID->"c24e3e27-d344-844d-af47-0a4102dc2b17"]
}, Open  ]],

