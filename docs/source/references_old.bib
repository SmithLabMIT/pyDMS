	year = {1983},
	doi = {10.1007/978-94-009-6634-5_6},
	keywords = {Draw Ratio, Extrusion Temperature, Heat Transfer Coefficient, Maxwell Fluid, Newtonian Fluid},
	pages = {179--216},
}

