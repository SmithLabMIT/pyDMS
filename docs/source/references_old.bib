@article{afifi-effat_thermal_1972,
	title = {The thermal stabilization of polyethylene oxide},
	volume = {8},
	issn = {0014-3057},
	url = {https://www.sciencedirect.com/science/article/pii/0014305772900341},
	doi = {10.1016/0014-3057(72)90034-1},
	abstract = {Molecular weight studies on commercial samples of polyethylene oxide indicate that they undergo a weak link scission reaction at temperatures above 70°. Weak links are also induced by oxidation and eliminated by dissolution of the polymers in ethanol. No degradation of the polymers occurs in ethanol solution and polymers precipitated from ethanol solution were stable to chain scission above 150°. Mechanisms for the chain scission and stabilization reactions are suggested.
Résumé
Des déterminations de poids moléculaire effectuées sur des échantillons commerciaux de poly(oxyde d'éthylène) indiquent qu'il se produit des ruptures de liaisons faibles pour des températures supérieures à 70°. Des liaisons faibles sont également introduites par oxydation et éliminées par dissolution des polymères dans l'éthanol. Il n'apparait pas de dégradation des polymères dans les solutions éthanoliques et les polymeres precipités à partir des solutions éthanoliques ne présentent pas de ruptures de chaines au-dessus de 150°. On propose des mécanismes pour la rupture des chaînes et les reactions de stabilisation
Resumen
Degli studi sul peso molecolare di campioni commerciali di ossido di polietilene indicano che questo subisce una debole scissione dei legami a temperature superiori a 70°. Si sono pure indotti dei legami deboli mediante ossidazione, che vengono eliminati disciogliendo i polimeri in etanolo. In soluzione nell'etanolo non avviene alcuna degradazione dei polimeri e i polimeri che precipitano sono stabili per quanto riguarda la scissione di catena sopra i 150°. Si avanza l'ipotesi di meccanismi di scissione di catena e di reazioni di stabilizzazione.
Zusammenfassung
Bei Molekulargewichtsuntersuchungen an Handelsprodukten von Polyäthylenoxid zeigt sich, daβ bei Temperaturen über 70° eine Spaltungsreaktion an einer schwachen Bindung erfolgt. Schwache Bindungen werden auch durch Oxydation eingeführt und beseitigt durch Auflösen der Polymeren in Äthanol. In Äthanollösung findet kein Abbau der Polymeren statt und aus Äthanollösung ausgefällte Polymere waren gegen eine Kettenspaltung bus über 150° stabil. Es werden Mechanisem für die Kettenspaltung und für die Stabilisierungsreaktion vorgeschlagen.},
	number = {2},
	urldate = {2024-11-29},
	journal = {European Polymer Journal},
	author = {Afifi-Effat, A. M. and Hay, J. N.},
	month = feb,
	year = {1972},
	pages = {289--297},
}

@article{lai_thermo-oxidative_2003,
	title = {Thermo-oxidative degradation of poly(ethylene glycol)/poly(l-lactic acid) blends},
	volume = {44},
	issn = {0032-3861},
	url = {https://www.sciencedirect.com/science/article/pii/S0032386103009510},
	doi = {10.1016/j.polymer.2003.10.035},
	abstract = {The thermo-oxidative degradation of poly(ethylene glycol)/poly(l-lactic acid) (PEG/PLLA) blends was studied by infra-red spectroscopy (IR), differential scanning calorimetry (DSC), gel permeation chromatography (GPC) and thermogravimetry (TGA). The thermo-oxidative degradation of PEG occurred after a period time of aging in air at 80 °C. The mechanism of thermo-oxidative degradation of PEG was found to be the random chain scission of the main chain. As PEG blending with PLLA, the existence of PLLA appeared to enhance the thermo-oxidative degradation of PEG. The enhancement of thermo-oxidative degradation increased first and then decreased with the increase of PLLA. The results could be attributed to the ease of abstraction of the carboxylic hydrogen (–COOH) of PLLA, which enhanced the thermo-oxidative degradation of PEG. Also, the dilution effect of PLLA on the concentration of free radicals was an important factor of the thermo-oxidative degradation.},
	number = {26},
	urldate = {2024-11-29},
	journal = {Polymer},
	author = {Lai, Wei-Chi and Liau, Wen-Bin},
	month = dec,
	year = {2003},
	keywords = {Blends, Free radical, Thermo-oxidative degradation},
	pages = {8103--8109},
}

@article{ensing_origin_2019,
	title = {On the origin of the extremely different solubilities of polyethers in water},
	volume = {10},
	copyright = {2019 The Author(s)},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-019-10783-z},
	doi = {10.1038/s41467-019-10783-z},
	abstract = {The solubilities of polyethers are surprisingly counter-intuitive. The best-known example is the difference between polyethylene glycol ([–CH2–CH2–O–]n) which is infinitely soluble, and polyoxymethylene ([–CH2–O–]n) which is completely insoluble in water, exactly the opposite of what one expects from the C/O ratios of these molecules. Similar anomalies exist for oligomeric and cyclic polyethers. To solve this apparent mystery, we use femtosecond vibrational and GHz dielectric spectroscopy with complementary ab initio calculations and molecular dynamics simulations. We find that the dynamics of water molecules solvating polyethers is fundamentally different depending on their C/O composition. The ab initio calculations and simulations show that this is not because of steric effects (as is commonly believed), but because the partial charge on the O atoms depends on the number of C atoms by which they are separated. Our results thus show that inductive effects can have a major impact on aqueous solubilities.},
	language = {en},
	number = {1},
	urldate = {2024-11-29},
	journal = {Nature Communications},
	author = {Ensing, Bernd and Tiwari, Ambuj and Tros, Martijn and Hunger, Johannes and Domingos, Sérgio R. and Pérez, Cristóbal and Smits, Gertien and Bonn, Mischa and Bonn, Daniel and Woutersen, Sander},
	month = jun,
	year = {2019},
	note = {Publisher: Nature Publishing Group},
	keywords = {Chemical physics},
	pages = {2893},
}

