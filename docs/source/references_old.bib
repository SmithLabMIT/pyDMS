@article{vopicka_phenomenology_2022,
	title = {Phenomenology of vapour sorption in polymers of intrinsic microporosity {PIM}-1 and {PIM}-{EA}-{TB}: envelopment of sorption isotherms},
	volume = {35},
	issn = {2211-3398},
	shorttitle = {Phenomenology of vapour sorption in polymers of intrinsic microporosity {PIM}-1 and {PIM}-{EA}-{TB}},
	url = {https://www.sciencedirect.com/science/article/pii/S2211339821001180},
	doi = {10.1016/j.coche.2021.100786},
	abstract = {Vapour sorption isotherms for PIM-1 and PIM-EA-TB exhibit-specific sigmoidal shapes. Moreover, obtained sorption uptakes of tested organic compounds appear inside confined envelopes while the volatility of the sorptive strongly influences the sorption uptakes. Thus, the infinite dilution solubility coefficients depend mainly on the vapour pressure of the sorptive. Sorption isotherms were parameterised with the GAB model of multilayer adsorption. Although the observed sorption isotherms likely result from a rather complex phenomenon involving adsorption, micropore filling and plasticization of the polymer, the model provided physically interpretable parameter values. In particular, one adsorption centre (as assumed by the GAB model) is formed by ∼0.7 mer units of either PIM-1 or PIM-EA-TB for all sorptives. We hypothesize that sorption isotherms of other than tested volatile compounds in PIM-1 and PIM-EA-TB can presumably fit into the observed sorption envelopes and that other PIMs should exhibit similar sorption envelopments.},
	urldate = {2025-10-21},
	journal = {Curr. Opin. Chem. Eng.},
	author = {Vopička, Ondřej and Lanč, Marek and Friess, Karel},
	month = mar,
	year = {2022},
	pages = {100786},
}

@article{doghieri_solubility_1996,
	title = {Solubility and diffusivity of ethanol in {PTMSP}:  {Effects} of activity and of polymer aging},
	volume = {35},
	issn = {0888-5885},
	shorttitle = {Solubility and diffusivity of ethanol in {PTMSP}},
	url = {https://doi.org/10.1021/ie9506781},
	doi = {10.1021/ie9506781},
	abstract = {Experimental data are reported on the solubility and diffusivity of ethanol vapors in poly[1-(trimethylsilyl)-1-propyne] (PTMSP). Solubility and diffusivity data at 30 °C have been measured from differential sorption experiments through a gravimetric technique. The effects of polymer prehistory were also inspected by considering samples preswollen in liquid methanol and in liquid ethanol as well as samples consolidated under vacuum for 5 months. The resulting behaviors are compared with those obtained from untreated samples. Polymer aging under different conditions has been characterized in terms of solubility, diffusivity, and mobility variations. Remarkably, in all cases a nonmonotonous dependence of diffusivity D versus ethanol mass fraction was observed:  in the activity range inspected, up to 0.5, with increasing the ethanol content, D initially decreases, then increases, and finally decreases again. Such unusual behavior is associated with the thermodynamic contribution to the diffusion coefficient, while the mobility factor is a monotonously decreasing function of the ethanol mass fraction.},
	number = {7},
	urldate = {2025-10-21},
	journal = {Ind. Eng. Chem. Res.},
	author = {Doghieri, F. and Biavati, D. and Sarti, G. C.},
	month = jan,
	year = {1996},
	pages = {2420--2430},
}

