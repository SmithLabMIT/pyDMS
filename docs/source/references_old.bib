@article{kuon_self-intermediate_2017,
	title = {Self-intermediate scattering function analysis of supercooled water confined in hydrophilic silica nanopores},
	volume = {146},
	issn = {0021-9606},
	url = {https://doi.org/10.1063/1.4984764},
	doi = {10.1063/1.4984764},
	abstract = {We study the temperature dependence of the self-intermediate scattering function for supercooled water confined in hydrophilic silica nanopores. We simulate the simple point charge/extended model of water confined to pores of radii 20 Å, 30 Å, and 40 Å over a temperature range of 210 K to 250 K. First, we examine the temperature dependence of the structure of the water and find that there is layering next to the pore surface for all temperatures and diameters. However, there exists a region in the center of the pore where the density is nearly constant. Using the density profile, we divide confined water into different regions and compare the dynamics of the water molecules that start in these regions. To this end, we examine the mean-squared displacement and the self-intermediate scattering functions for the water hydrogens, which would allow one to connect our results with quasi-elastic neutron scattering experiments. We examine the dependence of the self-intermediate scattering function on the magnitude and direction of the wavevector, as well as the proximity to the silica surface. We also examine the rotational-translational decoupling. We find that the anisotropy of the dynamics and the rotational-translational decoupling is weakly temperature dependent.},
	number = {21},
	urldate = {2025-10-17},
	journal = {The Journal of Chemical Physics},
	author = {Kuon, Nicholas and Milischuk, Anatoli A. and Ladanyi, Branka M. and Flenner, Elijah},
	month = jun,
	year = {2017},
	pages = {214501},
}

